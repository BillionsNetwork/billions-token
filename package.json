{
    "name": "billions-token-deployment",
    "description": "Token deployment for Billions Network",
    "version": "1.0.0",
    "license": "MIT",
    "scripts": {
        "compile": "hardhat compile",
        "test": "hardhat test",
        "coverage": "hardhat coverage",
        "lint:contracts": "npx solhint contracts/**/*.sol",
        "prettier:contracts": "prettier --write --plugin=prettier-plugin-solidity 'contracts/**/*.sol'",
        "token:generate": "hardhat run scripts/deployToken/generateFromMultisigDeterministic.ts",
        "token:deploy:localhost": "hardhat run scripts/deployToken/deploy.ts --network localhost",
        "token:deploy:sepolia": "hardhat run scripts/deployToken/deploy.ts --network sepolia",
        "token:deploy:mainnet": "hardhat run scripts/deployToken/deploy.ts --network mainnet",
        "token:verify:sepolia": "hardhat run scripts/deployToken/verifyDeployment.ts --network sepolia",
        "token:verify:mainnet": "hardhat run scripts/deployToken/verifyDeployment.ts --network mainnet",
        "staking:deploy:localhost": "hardhat run scripts/deployStakingRewards/deploy.ts --network localhost",
        "staking:deploy:sepolia": "hardhat run scripts/deployStakingRewards/deploy.ts --network sepolia",
        "staking:deploy:mainnet": "hardhat run scripts/deployStakingRewards/deploy.ts --network mainnet",
        "staking:verify:sepolia": "hardhat run scripts/deployStakingRewards/verify.ts --network sepolia",
        "staking:verify:mainnet": "hardhat run scripts/deployStakingRewards/verify.ts --network mainnet",
        "postinstall": "patch-package"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "dependencies": {
        "@nomicfoundation/hardhat-ledger": "1.0.3",
        "@nomicfoundation/hardhat-toolbox": "^5.0.0",
        "@openzeppelin/contracts-upgradeable": "^5.4.0",
        "@openzeppelin/hardhat-upgrades": "^3.9.1",
        "@types/node": "^22.10.2",
        "dotenv": "^16.4.7",
        "hardhat": "^2.22.18",
        "patch-package": "^8.0.0",
        "prettier": "^3.7.4",
        "prettier-plugin-solidity": "^1.1.1",
        "solhint": "^6.0.2",
        "solhint-plugin-prettier": "^0.1.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.7.2",
        "winston": "^3.19.0"
    },
    "overrides": {
        "diff": "^8.0.3",
        "axios": "^1.13.5",
        "lodash": "^4.17.23",
        "bn.js": "^5.2.3",
        "minimatch": "^10.2.2"
    }
}
